generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  }

// Handles the required Guest Login sessions and Profile Settings
model User {
  id        String   @id @default(uuid())
  username  String   @unique
  role      String   @default("guest")
  
  // Added fields for the Settings Profile page
  email     String?
  fullName  String?
  title     String?

  createdAt DateTime @default(now())
}

// Maps directly to the Caseload table shown in the Figma design
model Task {
  id            String    @id @default(uuid())
  fullName      String
  lastName      String
  iepDue        DateTime?
  evalDue       DateTime?
  collaborators String?   
  serviceTime   String?
  school        String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  priority      String?   @default("Normal")
  status        String?   @default("Backlog")
}

model Project {
  id          String    @id @default(uuid())
  name        String
  priority    String?   @default("Normal")
  lead        String?   // Stores the lead's name/initials
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}